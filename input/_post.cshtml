@model IDocument

@{
  string excerpt = Model.GetString(Keys.Excerpt);
}

<div class="content" style="margin-bottom: 2em;">
  <header class="major">
    <h2>@Html.DocumentLink(Model)</h2>
    @if (Model.ContainsKey("Lead"))
    {
      <h3>@Model.GetString("Lead")</h3>
    }
  </header>
  <p><em>Published on @Model.GetDateTime(WebKeys.Published).ToLongDateString(Context)</em></p>
  @if (!string.IsNullOrEmpty(excerpt))
  {
    @Html.Raw(excerpt)
    <p><a href="@Context.GetLink(Model)">Read more...</a></p>
  }
</div>
