<nav id="nav">
  <ul>
    <li><strong><a href='@Context.GetLink("/")'>@Context.GetString("SiteTitle")</a></strong></li>
    @Html.Partial("_navbar")
    @if (Context.GetBool(WebKeys.GenerateSearchIndex))
    {
      <li>
        <form action='@Context.GetLink("/search")' method="GET" style="display:inline;">
          <input type="search" placeholder="Search" name="query" />
          <input type="submit" hidden />
        </form>
      </li>
    }
  </ul>
</nav>
